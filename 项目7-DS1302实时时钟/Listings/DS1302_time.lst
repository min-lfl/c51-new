  69   1        DS1302_CE=0;DS1302_IO=0;DS1302_SCLK=0;  //初始化I/O口，避免前面程序对读取函数的影响
  70   1        
  71   1        //像ds1302发送一段数据表明要读取哪些
  72   1        DS1302_CE=1;
