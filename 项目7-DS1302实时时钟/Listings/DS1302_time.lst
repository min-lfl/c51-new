  58          //写入时间和读出时间一个函数搞定
  59          unsigned char write_and_read_DS1302(unsigned char code1,unsigned char num){
  60   1        unsigned char where;
  61   1        
  62   1        //判断是不是要对读保护和写保护操作
  63   1        if(code1==0x8e){write_DS1302(code1,num);return 88;}
  64   1        if(code1==0x8f){return read_DS1302(code1);}
  65   1        
