  81   2          if(DS1302_IO){time|=0x01<<i;}
  82   2        }
  83   1        
  84   1        DS1302_CE=0;DS1302_IO=0;DS1302_SCLK=0;//完成一次读取循环后把用到的接口复位
  85   1        return time;
