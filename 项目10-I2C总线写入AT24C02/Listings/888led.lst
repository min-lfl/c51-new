  35           * @note   定时器每2ms调用一次，实现多位数码管的动态显示
  36           *         自动跳过值为10的位置（不显示），避免显示亮度不均
  37           *         显示密度自适应：数字多时整体偏暗，数字少时整体偏亮，但亮度均匀
  38           */
  39          void Scan_888led(){
  40   1        static unsigned char number=0,i=0;//number为自加值，i为超时判定
  41   1        
  42   1        
  43   1        // 跳过不显示的位置（值为10），最多查找8次避免死循环
  44   1        while(code_888led[number]==10 && i<8){
  45   2          number = (number + 1) % 8;
  46   2          i++;
  47   2        }i=0;//把i归0
  48   1        
  49   1        
  50   1        Nixie((number+1),code_888led[number]);//在对应位置显示对应数据
  51   1        number = (number + 1) % 8; //更新到下一个位置，让number循环在0~7
  52   1      }
