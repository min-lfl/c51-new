   7          
   8          /**
   9            * @brief    AT24C02写入函数，内置了等待写入完成
  10            * @param    要写入的地址，对AT24C02的8K型号来说最大地址0~255
  11            * @param    要写入的数据，最长为1字节
  12            * @retval   返回0表示写入成功，返回1表示写入超时
  13            */
  14          bit write_AT24C02(unsigned char ADDRESS,Byte){
  15   1        unsigned char ack;//定义一个变量来保存应答
  16   1        unsigned int timeout = 0;//定义一个变量来自加判断超时
  17   1        
  18   1        //写入的主体部分
  19   1        start_I2C();
  20   1        write_I2C(AT24C02_ADDRESS);
  21   1        r_I2c();  //接受一个应答，可以用来判断，不过我们这里不做判断
  22   1        write_I2C(ADDRESS);
  23   1        r_I2c();
  24   1        write_I2C(Byte);
  25   1        r_I2c();
  26   1        stop_I2C();
  27   1        
  28   1        
  29   1        //等待写入完成就跳出循环（因为写入会有5ms的延迟，这个延迟内从设备无法做�
             -��任何应答，包括读写，所以干脆写完后把这5ms等待完）
  30   1        do{
  31   2          start_I2C();
  32   2          write_I2C(AT24C02_ADDRESS);//呼喊一下从设备
  33   2          ack=r_I2c();//接收一下回应
  34   2          stop_I2C();
  35   2          if(timeout++ > 10000){return 1;}//返回1就是超时后还没有写入完成
  36   2        }while(ack!=0);//收到回应就是设备写入完成了，跳出循环
  37   1        
  38   1        return 0;//返回0就是写入完成
  39   1      }
  40          
  41          
  42          /**
  43            * @brief    AT24C02接收函数，在特定地址位接收一个数据
  44            * @param    要在哪个地址接收
  45            * @retval   接收到的数据
  46            */
  47          unsigned char  read_AT24C02(unsigned char ADDRESS){
  48   1        unsigned char date=1;
  49   1        start_I2C();
  50   1        write_I2C(AT24C02_ADDRESS);//选择哪个设备发送
  51   1        r_I2c();
  52   1        write_I2C(ADDRESS);//发送要读哪位
  53   1        r_I2c();
C51 COMPILER V9.54   AT24C02                                                               11/09/2025 16:03:16 PAGE 2   

  54   1        
  55   1        //从这里开始读
  56   1        start_I2C();
  57   1        write_I2C(AT24C02_ADDRESS|0x01);//选择哪个设备接收
  58   1        r_I2c();
  59   1        date=read_I2C();//开始接收
  60   1        s_I2c(1);//接收完最后一个字节数据后主机要发送无应答
  61   1        stop_I2C();
  62   1        return date;
  63   1      }
