  13          unsigned char reverse_low_4bits(unsigned char byte) {
  14   1          unsigned char high = byte & 0xF0;    // 保存高4位
  15   1          unsigned char low = byte & 0x0F;     // 取低4位
  16   1          
  17   1          // 反转低4位：00001011 -> 低4位1011 -> 1101
  18   1          low = ((low & 0x1) << 3) | 
  19   1                ((low & 0x2) << 1) | 
  20   1                ((low & 0x4) >> 1) | 
  21   1                ((low & 0x8) >> 3);
  22   1          
  23   1          return high | low;  // 0000 | 1101 = 00001101
  24   1      }
