  35          ///**
  36          //  * @brief    把4位浮点二进制（后4位补0）转化为4位整型，如1101 0000转化为8125
  37          //  * @param    后4位补0的二进制数小数，比如0.75的小数部分是1100 0000
  38          //  * @retval   输出整数，1100 0000->7500，1101 0000->8125
  39          //  */
  40          
  41          unsigned int Floatchar_to_Decimalint(unsigned char binary) {
