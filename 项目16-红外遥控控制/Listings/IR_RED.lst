 240          /**
 241           * @brief  红外遥控初始化函数
 242           *         配置外部中断1 (INT1/P3.3) 和 定时器1 (Timer1 Mode 1)
 243           */
 244          void IR_Init(void) {
 245   1          // --- 定时器1 初始化 (16位定时器模式 Mode 1) ---
 246   1          TMOD &= 0x0F;  // 清除T1的模式位
 247   1          TMOD |= 0x10;  // 设置T1为模式1 (16位定时器)
 248   1          TH1 = 0x00;
 249   1          TL1 = 0x00;
 250   1          TF1 = 0;       // 清除TF1
 251   1          TR1 = 0;       // 停止T1
 252   1          ET1 = 0;       // 禁用T1中断 (本例使用查询方式)
 253   1      
 254   1          // --- 外部中断1 (INT1 - P3.3) 初始化 ---
 255   1          IT1 = 1;  // 设置INT1为下降沿触发
 256   1          // IE1 = 0;  // IE1是中断标志位，由硬件管理，软件通常不需要清零
 257   1          PX1 = 1;  // 设置INT1为高优先级 (推荐)
 258   1          EX1 = 1;  // 使能INT1中断
 259   1      
 260   1          EA = 1;   // 使能全局中断
 261   1      
 262   1          // 初始化状态机变量
 263   1          ir_state = IR_STATE_IDLE;
 264   1          ir_data_index = 0;
 265   1          ir_raw_data = 0;
 266   1          ir_addr = 0;
 267   1          ir_cmd = 0;
 268   1          ir_last_cmd = 0;
 269   1          ir_data_valid = 0;
 270   1          ir_repeat_flag = 0;
 271   1          ir_tick_count = 0;
 272   1          // ir_timer_overflow = 0; // <<<--- 移除了这个变量的初始化
 273   1          g_timer_overflow_flag = 0; // <<<--- 初始化新增的全局静态变量
 274   1      }
